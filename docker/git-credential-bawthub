#!/bin/sh
# git-credential-bawthub — provider-connect git credential helper.
#
# Asks the llm-bawt app to mint a fresh, short-lived GitHub App installation
# token (device-flow connection made in the setup wizard) and hands it to git
# as credential lines. Nothing durable is stored on disk.
#
# Only the `get` operation is answered: `store` and `erase` are no-ops so git
# never caches a token that is about to expire.
#
# Enabled by configuring `credential.helper = bawthub`. The tenant stack does
# that via GIT_CONFIG_* env in docker-compose.prod.yml; on the dev host the
# helper ships inert so bridges keep using their SSH identity.
#
# Env:
#   LLM_BAWT_API_URL              base URL of the app (default http://app:8642)
#   BRIDGE_GIT_CREDENTIAL_TOKEN   optional X-Bridge-Token guard value
[ "$1" = get ] || exit 0

exec curl -fsS --max-time 15 \
  -H "X-Bridge-Token: ${BRIDGE_GIT_CREDENTIAL_TOKEN:-}" \
  "${LLM_BAWT_API_URL:-http://app:8642}/v1/providers/github/git-credential"
